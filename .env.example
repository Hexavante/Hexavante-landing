# URL pública da API (usada no browser, ex: ViewTracker)
NEXT_PUBLIC_API_URL=https://api.hexavante.com.br
# URL base do app (CTAs "Ir para o app", login, registro)
NEXT_PUBLIC_APP_URL=https://app.hexavante.com.br
# URL da API para fetch server-side (pode ser interna no docker: http://hexavante-api:3045)
API_URL=https://api.hexavante.com.br
